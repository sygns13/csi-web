---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

type Size = "sm" | "md" | "lg";

interface Props {
  icon: IconName;
  size?: Size;
  class?: string;
}

const { icon, size = "md", class: className } = Astro.props;

// Hexágono con clip-path (§4.4): 56 px por defecto, fondo --surface-2 e ícono en --brand.
const box: Record<Size, string> = { sm: "size-10", md: "size-14", lg: "size-24" };
const iconSize: Record<Size, number> = { sm: 20, md: 28, lg: 40 };
---

<span
  class:list={[
    "clip-hex inline-flex shrink-0 items-center justify-center bg-surface-2 text-brand",
    box[size],
    className,
  ]}
  aria-hidden="true"
>
  <Icon name={icon} size={iconSize[size]} />
</span>
