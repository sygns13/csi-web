---
import Container from "../ui/Container.astro";
import { t } from "../../i18n";
import type { BreadcrumbItem } from "../../lib/jsonld";

interface Props {
  /** Ruta completa, empezando por Inicio. El último elemento es la página actual. */
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label={t("nav.breadcrumb")} class="bg-surface-tint">
  <Container>
    <ol class="flex flex-wrap items-center gap-x-2 pt-4 text-sm text-text-muted">
      {items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class="inline-flex items-center gap-2">
            {last ? (
              <span aria-current="page" class="font-medium text-text">
                {item.name}
              </span>
            ) : (
              <>
                <a
                  href={item.href}
                  class="inline-flex min-h-6 items-center text-link underline underline-offset-2 hover:decoration-2"
                >
                  {item.name}
                </a>
                <span aria-hidden="true">›</span>
              </>
            )}
          </li>
        );
      })}
    </ol>
  </Container>
</nav>
