---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import CircuitTraces from "../visuals/CircuitTraces.astro";
import { site } from "../../config/site";
import { t } from "../../i18n";
import { mailtoUrl, whatsappUrl } from "../../lib/links";

// Banda de llamada a la acción (§6.1 S10). Se usa en todas las páginas excepto Contacto.
const headingId = "cta-band-title";
---

<section aria-labelledby={headingId} class="relative overflow-hidden bg-surface-tint">
  <CircuitTraces class="absolute top-1/2 right-0 hidden h-56 w-auto -translate-y-1/2 md:block" />
  <Container class="relative py-16 lg:py-24">
    <div class="max-w-2xl">
      <h2 id={headingId} class="text-h2 font-bold text-text">
        {t("cta.bandTitle")}
      </h2>
      <p class="mt-4 text-lead text-text-muted">{t("cta.bandText")}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <Button href={whatsappUrl(t("wa.defaultMessage"))} brandIcon="whatsapp" external>
          {t("cta.whatsapp")}
        </Button>
        <Button href={site.phone.tel} variant="secondary" icon="phone">
          {t("cta.call")}
        </Button>
        <Button href={mailtoUrl()} variant="ghost">
          {t("cta.email")}
        </Button>
      </div>
    </div>
  </Container>
</section>
