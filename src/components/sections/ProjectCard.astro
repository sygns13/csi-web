---
// Tarjeta de proyecto. Variante por defecto (§6.1 S6, §6.3): maqueta genérica, sector, cliente,
// título, resumen y fecha. Variante `detailed` (índice /proyectos/, §6.5): insignias de sector y
// año, y hasta 2 insignias de servicios. Toda la tarjeta es clicable con el enlace extendido del
// título (§4.7).
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import ProjectVisual from "../visuals/ProjectVisual.astro";
import { t } from "../../i18n";
import {
  clientShortName,
  getServices,
  projectDatetime,
  projectHref,
  projectYear,
  sectorLabel,
  type Project,
} from "../../lib/content";

interface Props {
  project: Project;
  /** Nivel del título según la jerarquía de la página. */
  headingLevel?: 2 | 3;
  /** Variante del índice de proyectos (§6.5). */
  detailed?: boolean;
}

const MAX_SERVICE_BADGES = 2;

const { project, headingLevel = 3, detailed = false } = Astro.props;
const { title, client, sector, summary, dateLabel, visual } = project.data;
const Heading = headingLevel === 2 ? "h2" : "h3";

const services = detailed ? await getServices() : [];
const serviceLabels = project.data.services
  .slice(0, MAX_SERVICE_BADGES)
  .map((ref) => services.find((service) => service.id === ref.id)?.data.navLabel)
  .filter((label): label is string => Boolean(label));
---

<Card interactive padded={false} class="group/card flex h-full flex-col">
  <ProjectVisual variant={visual} class="border-b border-border" />
  <div class="flex flex-1 flex-col p-6">
    <ul class="flex flex-wrap gap-2">
      <li>
        <Badge>{sectorLabel(sector)}</Badge>
      </li>
      {detailed && (
        <li>
          <Badge>
            <time datetime={projectYear(project)}>{projectYear(project)}</time>
          </Badge>
        </li>
      )}
    </ul>
    <Heading class="mt-4 text-h3 font-semibold">
      <a
        href={projectHref(project.id)}
        class="link-stretched rounded-control text-text decoration-2 underline-offset-4 group-hover/card:underline"
      >
        {title}
      </a>
    </Heading>
    <p class="mt-2 text-sm font-semibold text-text-muted">{clientShortName(client)}</p>
    <p class="mt-3 text-text-muted">{summary}</p>
    {detailed ? (
      <ul aria-label={t("projects.services")} class="mt-auto flex flex-wrap gap-2 pt-5">
        {serviceLabels.map((label) => (
          <li>
            <Badge tone="outline">{label}</Badge>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-auto pt-4 text-sm text-text-muted">
        <time datetime={projectDatetime(project)}>{dateLabel}</time>
      </p>
    )}
  </div>
</Card>
