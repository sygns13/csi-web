---
// Cuadrícula de servicios de Inicio (§6.1 S3): 7 tarjetas + tarjeta de cierre.
import ServiceCard from "./ServiceCard.astro";
import OtherNeeds from "./OtherNeeds.astro";
import type { Service } from "../../lib/content";

interface Props {
  services: Service[];
  class?: string;
}

const { services, class: className } = Astro.props;
---

<ul class:list={["grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3", className]}>
  {services.map((service) => (
    <li>
      <ServiceCard service={service} />
    </li>
  ))}
  <li>
    <OtherNeeds />
  </li>
</ul>
