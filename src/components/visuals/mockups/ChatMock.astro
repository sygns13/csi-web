---
// Maqueta "chat" (§4.6): ventana con burbujas de conversación e indicador de IA. Espacio 400×250.
import MockWindow from "./MockWindow.astro";
import Icon from "../../ui/Icon.astro";
import { hexPoints } from "../geometry";
---

<g>
  <MockWindow x={56} y={16} width={288} height={218} chrome={false}>
    <polygon points={hexPoints(84, 41, 32)} class="fill-brand/15"></polygon>
    <Icon name="bot" size={18} x={75} y={32} class="text-brand" />
    <rect x="108" y="33" width="78" height="7" rx="3.5" class="fill-text-muted/40"></rect>
    <rect x="108" y="46" width="48" height="5" rx="2.5" class="fill-border"></rect>
    <rect x="290" y="31" width="38" height="20" rx="10" class="fill-primary"></rect>
    <text
      x="309"
      y="45"
      text-anchor="middle"
      font-size="11"
      font-weight="700"
      class="fill-on-primary font-sans"
    >
      IA
    </text>
    <line x1="56" x2="344" y1="64" y2="64" class="stroke-border" stroke-width="1.5"></line>

    <rect x="72" y="78" width="176" height="44" rx="12" class="fill-surface-2"></rect>
    <rect x="86" y="90" width="146" height="6" rx="3" class="fill-text-muted/30"></rect>
    <rect x="86" y="104" width="104" height="6" rx="3" class="fill-text-muted/30"></rect>

    <rect x="168" y="132" width="160" height="32" rx="12" class="fill-brand/15"></rect>
    <rect x="182" y="145" width="124" height="6" rx="3" class="fill-brand/45"></rect>

    <rect x="72" y="174" width="70" height="24" rx="12" class="fill-surface-2"></rect>
    <circle cx="92" cy="186" r="3.5" class="fill-brand-cyan"></circle>
    <circle cx="107" cy="186" r="3.5" class="fill-brand-cyan/70"></circle>
    <circle cx="122" cy="186" r="3.5" class="fill-brand-cyan/40"></circle>

    <rect
      x="72"
      y="206"
      width="226"
      height="20"
      rx="10"
      class="fill-surface stroke-border"
      stroke-width="1.5"
    ></rect>
    <rect x="86" y="213" width="90" height="6" rx="3" class="fill-border"></rect>
    <circle cx="316" cy="216" r="11" class="fill-primary"></circle>
    <Icon name="send" size={12} x={310} y={210} class="text-on-primary" />
  </MockWindow>
</g>
