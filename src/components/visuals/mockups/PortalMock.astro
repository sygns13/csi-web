---
// Maqueta "portal" (§4.6): portal web con cabecera, banner y tarjetas de noticias. 400×250.
import MockWindow from "./MockWindow.astro";
import Icon from "../../ui/Icon.astro";
import { hexPoints } from "../geometry";

const nav = [
  { x: 212, w: 30 },
  { x: 250, w: 34 },
  { x: 292, w: 28 },
  { x: 328, w: 34 },
];
const cards = [36, 150, 264];
---

<g>
  <MockWindow x={24} y={14} width={352} height={222}>
    <polygon points={hexPoints(50, 51, 18)} class="fill-brand"></polygon>
    <rect x="64" y="48" width="58" height="7" rx="3.5" class="fill-text-muted/40"></rect>
    {nav.map((n) => (
      <rect x={n.x} y="49" width={n.w} height="5" rx="2.5" class="fill-border" />
    ))}
    <line x1="24" x2="376" y1="64" y2="64" class="stroke-border" stroke-width="1.5"></line>

    <rect x="36" y="72" width="328" height="72" rx="10" class="fill-brand"></rect>
    <path
      d="M240 72H354a10 10 0 0 1 10 10v52a10 10 0 0 1-10 10H196Z"
      class="fill-brand-cyan"
      opacity="0.55"
    ></path>
    <rect x="54" y="90" width="150" height="10" rx="5" class="fill-surface/90"></rect>
    <rect x="54" y="108" width="110" height="6" rx="3" class="fill-surface/70"></rect>
    <rect x="54" y="122" width="56" height="12" rx="6" class="fill-surface"></rect>

    {cards.map((x) => (
      <g>
        <rect
          x={x}
          y="154"
          width="100"
          height="74"
          rx="8"
          class="fill-surface stroke-border"
          stroke-width="1.5"
        />
        <rect x={x + 6} y="160" width="88" height="32" rx="5" class="fill-surface-2" />
        <Icon name="image" size={14} x={x + 43} y={169} class="text-brand/70" />
        <rect x={x + 8} y="200" width="70" height="5" rx="2.5" class="fill-text-muted/40" />
        <rect x={x + 8} y="211" width="50" height="5" rx="2.5" class="fill-border" />
      </g>
    ))}
  </MockWindow>
</g>
