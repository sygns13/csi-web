---
// Maqueta "form" (§4.6): formulario público responsive en un navegador y en un teléfono. 400×250.
import MockWindow from "./MockWindow.astro";

const desktopFields = [92, 130, 168];
const phoneFields = [84, 116, 148];
---

<g>
  <MockWindow x={24} y={20} width={268} height={210}>
    <rect x="44" y="56" width="130" height="9" rx="4.5" class="fill-text-muted/40"></rect>
    <rect x="44" y="72" width="180" height="5" rx="2.5" class="fill-border"></rect>
    {desktopFields.map((y) => (
      <g>
        <rect x="44" y={y} width="56" height="5" rx="2.5" class="fill-text-muted/30" />
        <rect
          x="44"
          y={y + 9}
          width="196"
          height="20"
          rx="5"
          class="fill-surface stroke-border-strong/50"
          stroke-width="1.2"
        />
      </g>
    ))}
    <rect x="44" y="204" width="78" height="18" rx="6" class="fill-primary"></rect>
  </MockWindow>

  <rect
    x="262"
    y="42"
    width="114"
    height="196"
    rx="18"
    class="fill-surface stroke-border-strong/60"
    stroke-width="3"
  ></rect>
  <rect x="303" y="51" width="32" height="5" rx="2.5" class="fill-border"></rect>
  <rect x="276" y="68" width="62" height="7" rx="3.5" class="fill-text-muted/40"></rect>
  {phoneFields.map((y) => (
    <g>
      <rect x="276" y={y} width="34" height="4" rx="2" class="fill-text-muted/30" />
      <rect
        x="276"
        y={y + 8}
        width="86"
        height="16"
        rx="4"
        class="fill-surface stroke-border-strong/50"
        stroke-width="1.2"
      />
    </g>
  ))}
  <rect x="276" y="186" width="86" height="18" rx="6" class="fill-primary"></rect>
</g>
